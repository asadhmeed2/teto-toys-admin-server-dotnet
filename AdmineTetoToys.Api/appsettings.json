{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CorsOrigin": "http://localhost:4201",
  "RateLimit": {
    "Enabled": true,
    "ServiceName": "admin",
    "GlobalLimit": 100,
    "GlobalWindowSeconds": 60,
    "GlobalBurst": 100,
    "AuthLimit": 10,
    "AuthWindowSeconds": 60,
    "AuthBurst": 10,
    "StrictPathPrefixes": [
      "/api/auth"
    ],
    "TrustForwardedHeaders": false
  },
  "Jwt": {
    "AccessTokenTtl": "00:15:00",
    "RefreshTokenTtl": "1.00:00:00"
  },
  "Redis": {
    "Host": "127.0.0.1",
    "Port": "6379",
    "Password": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=TetoToys;Uid=TetoToys;Pwd=YourSqlPassword123!;"
  }
}
